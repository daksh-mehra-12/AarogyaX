# Generate a unique value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace_with_a_random_secret_before_starting

# Optional: enables the Gemini-powered clinical assistant.
GEMINI_API_KEY=

# Optional Firebase Web App settings for Google/Gmail sign-in.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional database URL; defaults to backend/aarogya.db (SQLite).
DATABASE_URL=

# Optional development-only seeded accounts. Leave blank to disable.
AAROGYA_DEFAULT_SEED_PASSWORD=

# Optional SMTP settings for backend email routes.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDER_EMAIL=

# Optional server settings.
PORT=3000
BACKEND_PORT=5000
# PYTHON=python
